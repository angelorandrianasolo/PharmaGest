# Copier ce fichier vers .env avant de lancer docker compose
SECRET_KEY=changez-cette-cle-dans-un-veritable-environnement
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=pharmagest
POSTGRES_USER=pharmagest
POSTGRES_PASSWORD=pharmagest

# Laissé vide : docker-compose.yml construit l'URL depuis les variables ci-dessus
DATABASE_URL=

SECURE_SSL_REDIRECT=false
