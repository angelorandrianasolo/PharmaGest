# Reverse proxy HTTPS de PharmaGest.
# Le domaine est fourni par la variable PHARMAGEST_DOMAIN (voir .env.prod).
# Caddy obtient et renouvelle automatiquement le certificat Let's Encrypt.
{$PHARMAGEST_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	# Les photos téléversées sont servies directement depuis le volume partagé.
	# Le préfixe /media est retiré avant la recherche du fichier : /media/photo.jpg
	# correspond donc bien à /srv/media/photo.jpg.
	handle /media/* {
		uri strip_prefix /media
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
