# Copier ce fichier vers .env.prod et renseigner toutes les valeurs avant déploiement.
# Ce fichier est lu à la fois par Docker Compose (--env-file) et par le conteneur web.
# Ne jamais versionner .env.prod : il contient des secrets.

# Clé secrète Django : générer une valeur unique avec
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=remplacez-par-une-cle-secrete-generee-aleatoirement

# Désactivation du mode debug en production
DEBUG=false

# Noms d'hôte autorisés par Django (séparés par des virgules, sans protocole)
ALLOWED_HOSTS=pharmacie.exemple.com

# Origines CSRF de confiance : URL complètes, toujours en https://
CSRF_TRUSTED_ORIGINS=https://pharmacie.exemple.com

# Domaine public desservi par Caddy (certificat Let's Encrypt automatique)
PHARMAGEST_DOMAIN=pharmacie.exemple.com

# Identifiants PostgreSQL : choisir un mot de passe long et unique
POSTGRES_DB=pharmagest
POSTGRES_USER=pharmagest
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-solide

# Forcer la redirection HTTPS (Caddy termine le TLS)
SECURE_SSL_REDIRECT=true

# Nom de la pharmacie affiché dans l'interface
PHARMACIE_NOM=Pharmacie Exemple

# Fichier d'environnement lu par Django dans le conteneur
DJANGO_ENV_FILE=.env.prod
